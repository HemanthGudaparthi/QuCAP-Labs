# Copy this file to .env and fill in real values — NEVER commit .env

# Flask
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
FLASK_DEBUG=0

# First-run admin bootstrap (remove after first launch)
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Database (PostgreSQL for production; omit to use local SQLite for dev)
DATABASE_URL=postgresql://user:password@localhost:5432/quantumlabs

# Claude AI — circuit builder (omit to use heuristic fallback)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# IBM Quantum (electron-based backend)
IBM_QUANTUM_TOKEN=YOUR_IBM_QUANTUM_API_TOKEN
IBM_QUANTUM_BACKEND=ibm_brisbane

# Google Drive — DB1 placeholder
# Path to service account JSON downloaded from Google Cloud Console
GDRIVE_CREDENTIALS_FILE=credentials/gdrive_service_account.json
# ID of the Google Drive folder that acts as DB1
GDRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
